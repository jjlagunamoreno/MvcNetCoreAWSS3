@model List<string>

@{
    string bucketUrl =
            configuration.GetValue<string>("AWS:BucketUrl");
}

@{
    ViewData["Title"] = "Listado de Archivos en S3";
}

<div class="container mt-5">
    <h2 class="mb-4">📂 Archivos almacenados en AWS S3</h2>

    <a href="@Url.Action("UploadFile")" class="btn btn-success mb-3">
        ➕ Subir nuevo archivo
    </a>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No hay archivos en el bucket.</div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>image</th>
                    <th>name</th>
                    <th class="text-end">actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var file in Model)
                {
                    <tr>
                        <td>@file</td>
                        <td><img src="@bucketUrl@file" style="width: 120px; height: 120px;" /></td>
                        <td class="text-end">
                            <a href="@Url.Action("DeleteFile", new { filename = file })"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('¿Estás seguro de que quieres eliminar este archivo?');">
                                🗑️ Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
